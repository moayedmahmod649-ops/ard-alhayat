{
 "regions": [
  "fra1"
 ],
 "functions": {
  "api/index.php": {
   "runtime": "vercel-php@0.8.0",
   "maxDuration": 30
  }
 },
 "routes": [
  {
   "src": "/(.*)",
   "headers": {
    "X-Robots-Tag": "noindex, nofollow",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000",
    "X-Frame-Options": "SAMEORIGIN"
   },
   "continue": true
  },
  {
   "src": "/assets/(.*)",
   "headers": {
    "Cache-Control": "public, max-age=604800"
   },
   "continue": true
  },
  {
   "src": "/",
   "dest": "/api/index.php"
  },
  {
   "src": "/(?:.*/)?\\.ht[^/]*",
   "status": 404,
   "dest": "/api/index.php"
  },
  {
   "src": "/.*\\.(?:php\\d?|phtml|phar)",
   "dest": "/api/index.php"
  },
  {
   "handle": "filesystem"
  },
  {
   "src": "/uploads/([a-z]+-[a-f0-9]{16}(?:-[mt])?\\.webp)",
   "dest": "https://ix0isq9brczxkolz.public.blob.vercel-storage.com/uploads/$1",
   "headers": {
    "Cache-Control": "public, max-age=2592000",
    "Content-Security-Policy": "default-src 'none'; sandbox"
   }
  },
  {
   "src": "/uploads/(.*)",
   "status": 404,
   "dest": "/api/index.php"
  },
  {
   "src": "/(.*)",
   "dest": "/api/index.php"
  }
 ]
}
