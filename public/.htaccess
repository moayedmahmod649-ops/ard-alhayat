# Ard Al-Hayat — Apache (cPanel) config. Mirrors app/dev-router.php.
Options -Indexes -MultiViews
DirectoryIndex index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS (uncomment after SSL is installed)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # uploads: only generated WebP names are served
  RewriteCond %{REQUEST_URI} ^/uploads/
  RewriteCond %{REQUEST_URI} !^/uploads/[a-z]+-[a-f0-9]{16}(-[mt])?\.webp$
  RewriteRule ^ - [F,L]
  # real static files under /assets and /uploads, and the favicon, are served directly
  RewriteCond %{REQUEST_URI} ^/(assets/|uploads/|favicon\.ico$)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^assets/ - [R=404,L]
  # everything else → front controller
  RewriteRule ^ index.php [L,QSA]
</IfModule>
# robots.txt is generated by index.php, so it is exempt
<FilesMatch "^(?!robots\.txt$).*\.(sqlite|sqlite3|db|log|ini|env|bak|zip|txt|md|json)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(webp|png|jpg|svg|woff2|css|js|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
